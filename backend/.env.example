PORT=5000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CLIENT_URL=http://localhost:5173,http://localhost:5174

# SMS — use mock (logs to console) until you configure a provider
SMS_PROVIDER=mock
# SMS_PROVIDER=africastalking
# AFRICASTALKING_USERNAME=sandbox
# AFRICASTALKING_API_KEY=your-api-key
# AFRICASTALKING_SENDER=SmartMatatu

# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Alert when matatu ETA is at or below this many minutes (default 2)
SMS_ETA_MINUTES=2
# Average matatu speed for ETA estimate (km/h)
MATATU_AVG_SPEED_KMH=25

# Email — use mock (logs to console) until you configure a provider
EMAIL_PROVIDER=mock
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_...
# EMAIL_FROM=Smart Matatu <alerts@yourdomain.com>
